{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "**/*.py",
      "requirements.txt",
      "railway.json",
      "README.md"
    ]
  },
  "deploy": {
    "startCommand": "python main2.py",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
